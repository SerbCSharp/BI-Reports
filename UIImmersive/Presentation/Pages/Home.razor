@page "/"

<div class="site-container">
    <div class="info-panel">
        <h1>Инновационный продукт</h1>

        <button @onclick='() => SceneTransition("home")'>Главная</button>
        <button @onclick='() => SceneTransition("features")'>Преимущества</button>
        <button @onclick='() => SceneTransition("contacts")'>Контакты</button>
