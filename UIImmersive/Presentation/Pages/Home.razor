@page "/"
@using System.Runtime.InteropServices.JavaScript

<h1>Тестирование JSImport</h1>
<button @onclick="TriggerAlert">Вызвать Alert</button>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Убедитесь, что код выполняется в браузере (на WebAssembly)
        if (OperatingSystem.IsBrowser())
        {
            // Загружаем JS-файл и связываем его с идентификатором "MyModule"
            await JSHost.ImportAsync("myModule", "../myModule.js");
        }
    }

    private void TriggerAlert()
    {
        if (OperatingSystem.IsBrowser())
        {
            MyJsInterop.ShowAlert("Привет мир!");
        }
    }
}
