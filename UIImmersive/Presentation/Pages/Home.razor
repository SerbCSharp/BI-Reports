@page "/"
@using System.Runtime.InteropServices.JavaScript

<!-- Привязываем уникальный ID к элементу canvas -->
<canvas id="three-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
<button @onclick="TriggerAlert">Вызвать Alert</button>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            await JSHost.ImportAsync("threeWrapper", "/js/threeWrapper.js");
        }
    }

    private void TriggerAlert()
    {
        if (OperatingSystem.IsBrowser())
        {
            MyJsInterop.InitThree("three-canvas");
        }
    }
}
